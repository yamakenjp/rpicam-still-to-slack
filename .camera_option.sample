OUTPUT_PATH=/tmp/image.jpg
FINAL_METADATA_PATH=/tmp/rpicam-still-to-slack-final.json
WIDTH=2304
HEIGHT=1296
QUALITY=92
HDR_MODE=auto
AUTOFOCUS_MODE=continuous
METERING=average
EMBED_EXIF_METADATA=1
EXIFTOOL=exiftool
EXIF_METADATA_REQUIRED=0
DEBUG=0
DEBUG_NO_UPLOAD=0

PREVIEW_TIMEOUT_MS=4000
TIMEOUT_MS=6000

# Adaptive shutter uses preview Lux to estimate the final shutter speed.
AUTO_SHUTTER=1
AUTO_SHUTTER_REFERENCE_US=4000000
AUTO_SHUTTER_REFERENCE_LUX=1.0
AUTO_SHUTTER_MIN_US=50000
AUTO_SHUTTER_MAX_US=12000000
AUTO_SHUTTER_STEP_US=1000
AUTO_SHUTTER_DAY_MAX_US=100000
AUTO_SHUTTER_TWILIGHT_MAX_US=1000000

DAY_EV=-0.3
DAY_EXPOSURE=normal
DAY_DENOISE=cdn_fast

TWILIGHT_EV=0
TWILIGHT_EXPOSURE=normal
TWILIGHT_DENOISE=cdn_fast

NIGHT_EV=0.8
NIGHT_EXPOSURE=long
NIGHT_DENOISE=cdn_hq
NIGHT_SHUTTER_US=4000000

EXPOSURE_NIGHT_MIN_US=10000
GAIN_NIGHT_MIN=4.0

# Fixed focus. When set, normal capture uses this value and skips focus pre-captures.
# LENS_POSITION=3.8

# Focus pre-capture tuning used when LENS_POSITION is not set.
FOCUS_PRECAPTURE_COUNT=3

# Focus calibration mode options. Used only with --focus-calibration.
# FOCUS_SCAN_VALUES=3.5,3.6,3.7,3.8,3.9,4.0,4.1,4.2,4.3,4.4,4.5
FOCUS_SCAN_START=0.0
FOCUS_SCAN_END=8.0
FOCUS_SCAN_STEP=0.5
FOCUS_CALIBRATION_DIR=/tmp/rpicam-still-to-slack-focus
